# Port, na którym nasłuchuje serwer w kontenerze
PORT=3000

# Katalog na dane (wewnątrz kontenera; zmapuj go na wolumen w docker-compose)
DATA_DIR=/data

# Token do autoryzacji bookmarkletu (dodawanie aukcji jednym kliknięciem ze strony
# Allegro) — wygeneruj np. `openssl rand -hex 24`
BOOKMARKLET_TOKEN=

# Dane aplikacji Allegro (Client ID / Client Secret z apps.developer.allegro.pl)
# NIE ustawia się tutaj — wpisujesz je w panelu, w sekcji "Ustawienia Allegro".
# Dzięki temu można je zmienić bez restartu kontenera.

# Nagłówek User-Agent wysyłany do API Allegro (wymagany przez regulamin REST API,
# wygenerowany w Generatorze User-Agent na apps.developer.allegro.pl). Domyślnie
# ustawiona jest wartość pasująca do aplikacji "Wawrzyc_Snajper" — jeśli założysz
# inną aplikację, wygeneruj nowy i nadpisz go tutaj.
# ALLEGRO_USER_AGENT=Wawrzyc_Snajper/1.0 (+https://github.com/wawrzyc/snajper)

# Logowanie do panelu jest na razie WYŁĄCZONE (panel jest otwarty dla każdego,
# kto ma dostęp do Twojej sieci VPN) — SESSION_SECRET / PANEL_PASSWORD_HASH nie
# są potrzebne. Żeby włączyć logowanie z powrotem, zobacz backend/src/index.ts.
